{
  "expo": {
    "name": "Tsuzuku",
    "slug": "anime-app",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "animetracker",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.mohinshaikh.animetracker",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mohinshaikh.animetracker",
      "adaptiveIcon": {
        "backgroundColor": "#160E3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "./plugins/with-local-notifications-only",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6C5CFF"
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "UpNext",
              "displayName": "Up Next",
              "description": "Your next episodes and when they air.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cdc751f6-cf63-41a0-b997-66e47e019725"
      }
    },
    "owner": "mohin.shaikh",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cdc751f6-cf63-41a0-b997-66e47e019725"
    }
  }
}
